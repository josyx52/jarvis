# ============================================================
#  JARVIS CENTER — Configuracao
#  Copie este ficheiro para .env e preencha os valores
#  NUNCA commitar o ficheiro .env com valores reais
# ============================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API de ingestao
JARVIS_API_PORT=8080
JARVIS_API_HOST=0.0.0.0

# Partições Redis Streams (default: 8)
JARVIS_PARTITIONS=8

# Segurança — API Key obrigatória para ingestão
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
JARVIS_API_KEY=

# Rate limiting (pedidos por IP por minuto, default: 200)
JARVIS_RATE_LIMIT=200

# Swagger UI activo só em desenvolvimento (0=desligado, 1=ligado)
JARVIS_DOCS=0

# CORS — origens permitidas separadas por vírgula (vazio = nenhuma)
# Exemplo: JARVIS_CORS_ORIGINS=http://localhost:3000,https://monitoring.empresa.com
JARVIS_CORS_ORIGINS=

# AI — Azure Foundry
FOUNDRY_API_KEY=
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/anthropic
